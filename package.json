{
  "name": "mayo-fix-enterprise",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Repair & Maintenance System by Mayo Tech",
  "author": "Mayo Tech",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist dist-electron && tsc && vite build && electron-builder",
    "publish": "rimraf dist dist-electron && tsc && vite build && electron-builder --publish always",
    "clean": "rimraf dist dist-electron",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "keygen": "node scripts/keygen.js",
    "postinstall": "electron-rebuild -f",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/youssefamr080/repair-shop-system.git"
  },
