{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ESNext",
        "sourceMap": true,
        "strict": true,
        "outDir": "../dist-electron",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": [
            "ESNext"
        ],
        "types": [
            "node",
            "electron"
        ]
    },
    "include": [
        "**/*.ts"
    ]
}